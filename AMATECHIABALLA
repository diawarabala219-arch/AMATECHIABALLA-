<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AMATECHIA BALLA & MOUSSA</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}
body{background:#0a0a0a;color:#fff;display:flex;flex-direction:column;height:100vh}
.header{padding:16px;background:#111;border-bottom:1px solid #222;display:flex;align-items:center;gap:12px}
.logo{width:44px;height:44px;background:linear-gradient(135deg,#CE1126,#FCD116,#009460);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;color:#000}
.chat{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:14px}
.msg{max-width:88%;padding:14px 16px;border-radius:18px;line-height:1.5;font-size:14px}
.bot{background:#1e1e1e;align-self:flex-start}
.user{background:linear-gradient(135deg,#FCD116,#009460);color:#000;align-self:flex-end;font-weight:600}
.input-area{padding:12px;background:#111;border-top:1px solid #222;display:flex;gap:10px}
.input-area input{flex:1;background:#1e1e1e;border:none;border-radius:24px;padding:13px 18px;color:#fff;outline:none}
.btn{background:linear-gradient(135deg,#CE1126,#FCD116);border:none;width:44px;height:44px;border-radius:50%;font-size:18px}
.badge{background:#222;padding:4px 10px;border-radius:20px;font-size:11px;border:1px solid #333}
</style>
</head>
<body>
<div class="header">
<div class="logo">AB</div>
<div>
<div style="font-weight:800">AMATECHIA BALLA</div>
<div style="font-size:11px;color:#00ff88">● Par Balla Diawara & Moussa • Conakry 🇬🇳 • 613754349</div>
</div>
</div>
<div class="chat" id="chat">
<div class="msg bot">Salut ! Je suis AMATECH IA BALLA 🇬🇳<br><br>Créée par <b>Balla Diawara & Moussa</b>, première IA Guinéenne à Conakry.<br><br>Comment je peux t'aider ?</div>
</div>
<div class="input-area">
<input id="input" placeholder="Question pour Balla & Moussa...">
<button class="btn" onclick="send()">➤</button>
</div>
<script>
const chat=document.getElementById('chat');
const input=document.getElementById('input');
function send(){
const txt=input.value.trim(); if(!txt) return;
chat.innerHTML+=`<div class='msg user'>${txt}</div>`;
input.value='';
chat.scrollTop=chat.scrollHeight;
setTimeout(()=>{
chat.innerHTML+=`<div class='msg bot'>Merci ! Balla & Moussa ont reçu : "${txt}"<br><br>Equipe AMATECHIABALLA 🇬🇳<br>Contact : 613754349</div>`;
chat.scrollTop=chat.scrollHeight;
},700);
}
input.addEventListener('keydown',e=>{if(e.key==='Enter') send()});
</script>
</body>
</html>
